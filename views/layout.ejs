<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Vitrina 3D</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://unpkg.com/aos@2.3.1/dist/aos.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=Montserrat:wght@300;700;900&display=swap" rel="stylesheet">
  <script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/4.0.0/model-viewer.min.js"></script>
  <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
</head>
<body>
  <div class="branch-decor branch-left" aria-hidden="true"></div>
  <div class="branch-decor branch-right" aria-hidden="true"></div>
  <nav class="navbar" id="navbar">
    <div class="nav-container">
      <a href="/" class="nav-logo">Vitrina 3D</a>
      <div class="nav-links">
        <a href="/#galeria" class="nav-link">Coleccion</a>
        <a href="/#features" class="nav-link">Info</a>
        <a href="/admin" class="nav-link">Admin</a>
      </div>
    </div>
  </nav>
  <main class="main-content">
    <%- include(body) %>
  </main>
  <footer class="footer">
    <div class="footer-container">
      <div class="footer-logo">
        <img src="/assets/logo_iesmutxamel.png" alt="IES Mutxamel" class="footer-logo-img">
      </div>
      <div class="footer-info">
        <h4>Vitrina 3D</h4>
        <p>Proyecto de digitalizacion de especies para exposicion interactiva con realidad aumentada.</p>
        <p class="footer-credit">IES Mutxamel &mdash; info@iesmutxamel.es</p>
      </div>
      <div class="footer-links">
        <a href="/">Inicio</a>
        <a href="/#galeria">Coleccion</a>
        <a href="/admin">Administracion</a>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; 2026 Vitrina 3D &middot; IES Mutxamel</p>
    </div>
  </footer>
  <script>
    AOS.init({ duration: 700, easing: 'ease-out-cubic', once: true, offset: 60 });

    var navbar = document.getElementById('navbar');
    if (navbar) {
      var onScroll = function() {
        if (window.scrollY > 40) {
          navbar.classList.add('scrolled');
        } else {
          navbar.classList.remove('scrolled');
        }
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    }
  </script>
</body>
</html>
