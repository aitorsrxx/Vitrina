<div class="species-page">
  <div class="species-viewer-section" id="viewer-container">
    <% if (isGLB) { %>
      <model-viewer
        id="model-viewer"
        src="<%= species.modelPath %>"
        ar
        ar-modes="webxr scene-viewer quick-look"
        ar-scale="auto"
        camera-controls
        touch-action="pan-y"
        bounds="tight"
        exposure="1"
        camera-target="auto auto auto"
        style="width:100%;height:100%"
        poster="<%= species.thumbnail || '' %>"
        reveal="auto"
        loading="eager"
      >
        <button slot="ar-button" class="ar-button" id="ar-slot-button"> Ver en tu espacio </button>
        <div slot="progress-bar" style="position:absolute;bottom:0;left:0;width:100%;height:4px;background:#333">
          <div style="height:100%;background:var(--sage-dark);width:0%" id="mv-progress"></div>
        </div>
      </model-viewer>
    <% } else { %>
      <div id="three-container" style="width:100%;height:100%">
        <div class="three-loading" id="three-loading">
          <div class="spinner"></div>
          <p>Cargando modelo 3D...</p>
        </div>
      </div>
    <% } %>
  </div>

  <div class="species-sidebar">
    <a href="/" class="back-link">&larr; Volver al catalogo</a>
    <h1><%= species.name %></h1>
    <% if (species.scientificName) { %>
      <p class="scientific-name"><%= species.scientificName %></p>
    <% } %>
    <% if (species.description) { %>
      <p class="description"><%= species.description %></p>
    <% } %>
    <% if (species.habitat) { %>
      <p class="habitat"><strong>Habitat:</strong> <%= species.habitat %></p>
    <% } %>
    <p class="model-info"><small>Formato: <%= species.modelFormat.replace('.','').toUpperCase() %></small></p>

    <div class="ar-info" id="ar-info-panel">
      <h3>Realidad Aumentada</h3>
      <% if (isGLB) { %>
        <div id="ar-status">Listo &mdash; abre en tu movil</div>
        <p id="ar-hint">Toca el boton flotante sobre el modelo para colocarlo en tu espacio real.</p>
        <% if (hasTextures) { %>
          <p style="font-size:0.8rem;color:var(--gold);margin-top:0.5rem">Texturas externas no se ven en AR. Hornea (bake) las texturas dentro del GLB al exportarlo.</p>
        <% } %>
        <div class="ar-actions">
          <button id="btn-ar-activate" class="btn-ar" onclick="triggerAR()"> Activar AR </button>
        </div>
      <% } else { %>
        <p>AR solo disponible con GLB/GLTF. Convierte tu archivo a GLB.</p>
        <div class="ar-actions">
          <button class="btn-ar" disabled style="opacity:0.5;cursor:not-allowed">AR no disponible</button>
        </div>
      <% } %>
    </div>

    <div class="qr-section">
      <h3>QR para la vitrina</h3>
      <p>Imprime este codigo QR y colocalo junto a la especie.</p>
      <div class="qr-container">
        <img src="<%= species.qrCode %>" alt="QR para <%= species.name %>" class="qr-image">
      </div>
      <a href="<%= species.qrCode %>" download="QR-<%= species.name %>.png" class="btn-download"> Descargar QR </a>
    </div>
  </div>
</div>

<% if (!isGLB) { %>
<script type="importmap">
{
  "imports": {
    "three": "https://unpkg.com/three@0.170.0/build/three.module.js",
    "three/addons/": "https://unpkg.com/three@0.170.0/examples/jsm/"
  }
}
</script>
<script type="module">
import * as THREE from 'three';
import { OrbitControls } from 'three/addons/controls/OrbitControls.js';

const container = document.getElementById('three-container');
const loadingEl = document.getElementById('three-loading');

const scene = new THREE.Scene();
scene.background = new THREE.Color(0xF5EFE8);

const camera = new THREE.PerspectiveCamera(45, container.clientWidth / container.clientHeight, 0.01, 500);
camera.position.set(3, 2, 5);

const renderer = new THREE.WebGLRenderer({ antialias: true });
renderer.setSize(container.clientWidth, container.clientHeight);
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
renderer.setClearColor(0xF5EFE8);
container.appendChild(renderer.domElement);

const controls = new OrbitControls(camera, renderer.domElement);
controls.enableDamping = true;
controls.dampingFactor = 0.08;
controls.target.set(0, 0, 0);
controls.minDistance = 0.1;
controls.maxDistance = 100;

const ambientLight = new THREE.AmbientLight(0xffffff, 1.5);
scene.add(ambientLight);
const dirLight = new THREE.DirectionalLight(0xffffff, 2);
dirLight.position.set(5, 10, 7);
scene.add(dirLight);
const backLight = new THREE.DirectionalLight(0xffffff, 0.5);
backLight.position.set(-3, 1, -2);
scene.add(backLight);

scene.add(new THREE.GridHelper(5, 20, 0xD5C9B8, 0xE8DDD0));

function fitCameraToObject(object) {
  const box = new THREE.Box3().setFromObject(object);
  const center = box.getCenter(new THREE.Vector3());
  const size = box.getSize(new THREE.Vector3());
  const maxDim = Math.max(size.x, size.y, size.z);
  if (maxDim < 0.001) return;
  const fov = camera.fov * (Math.PI / 180);
  let distance = maxDim / (2 * Math.tan(fov / 2));
  distance = Math.max(distance * 1.5, 0.5);
  camera.position.set(center.x + distance * 0.5, center.y + distance * 0.3, center.z + distance);
  controls.target.copy(center);
  controls.update();
}

const format = '<%= species.modelFormat %>';
const modelPath = '<%= species.modelPath %>';
const texturePaths = <%- JSON.stringify(species.textures || []) %>;

function showError(msg, detail) {
  container.innerHTML = '<div style="display:flex;align-items:center;justify-content:center;height:100%;text-align:center;padding:2rem"><div><p style="font-size:1.2rem;color:#f87171;margin-bottom:0.5rem">'+msg+'</p><p style="color:#8888a0;max-width:400px">'+detail+'</p></div></div>';
}

async function loadModel() {
  try {
    if (format === '.ply') {

      // Detect if this is a Gaussian Splat PLY by checking the header
      const headerResponse = await fetch(modelPath, { headers: { Range: 'bytes=0-4095' } });
      const headerText = await headerResponse.text();
      const isGS = headerText.includes('scale_0') || headerText.includes('rot_0') ||
                   headerText.includes('opacity') && headerText.includes('nx');

      if (isGS) {
        // Gaussian Splat: parse as point cloud
        showError('Gaussian Splat detectado',
          'Este archivo PLY es un Gaussian Splat. Se está cargando como nube de puntos. Para mejor calidad visual y AR, convierte el modelo a formato GLB.');
        await new Promise(r => setTimeout(r, 100));
        loadingEl.style.display = 'flex';

        await loadPLYAsPoints(modelPath);
        return;
      }

      const { PLYLoader } = await import('three/addons/loaders/PLYLoader.js');
      const loader = new PLYLoader();
      const geometry = await loader.loadAsync(modelPath);

      if (!geometry.index && geometry.attributes.position.count > 0) {
        // No faces — render as point cloud
        const hasColors = geometry.hasAttribute('color');
        const positions = geometry.attributes.position.array;
        const colors = hasColors ? geometry.attributes.color.array : null;

        const bufGeom = new THREE.BufferGeometry();
        bufGeom.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
        if (colors) bufGeom.setAttribute('color', new THREE.Float32BufferAttribute(colors, 3));
        const mat = new THREE.PointsMaterial({
          size: 0.01,
          vertexColors: !!colors,
          sizeAttenuation: true
        });
        const points = new THREE.Points(bufGeom, mat);
        scene.add(points);
        if (loadingEl) loadingEl.remove();
        fitCameraToObject(points);
        return;
      }

      geometry.computeVertexNormals();
      const hasColors = geometry.hasAttribute('color');

      let material;
      if (texturePaths.length > 0) {
        const texLoader = new THREE.TextureLoader();
        const texture = await texLoader.loadAsync(texturePaths[0].path);
        texture.colorSpace = THREE.SRGBColorSpace;
        material = new THREE.MeshStandardMaterial({
          map: texture,
          roughness: 0.5,
          metalness: 0.05
        });
      } else {
        material = new THREE.MeshStandardMaterial({
          vertexColors: hasColors,
          color: hasColors ? 0xffffff : 0x8b9dc3,
          roughness: 0.5,
          metalness: 0.05,
          flatShading: false
        });
      }
      const mesh = new THREE.Mesh(geometry, material);
      scene.add(mesh);
      if (loadingEl) loadingEl.remove();
      fitCameraToObject(mesh);

    } else if (format === '.obj') {
      const loadedTextures = [];
      if (texturePaths.length > 0) {
        const texLoader = new THREE.TextureLoader();
        for (const t of texturePaths) {
          try {
            const tex = await texLoader.loadAsync(t.path);
            tex.colorSpace = THREE.SRGBColorSpace;
            loadedTextures.push({ name: t.name.toLowerCase(), texture: tex });
          } catch (e) { console.warn('Texture load failed:', t.path, e); }
        }
      }

      const { OBJLoader } = await import('three/addons/loaders/OBJLoader.js');
      const objLoader = new OBJLoader();
      const object = await objLoader.loadAsync(modelPath);

      const meshes = [];
      object.traverse(child => {
        if (child.isMesh) meshes.push(child);
      });

      object.traverse(child => {
        if (child.isMesh) {
          let texToApply = null;
          if (loadedTextures.length > 0) {
            const childName = (child.name || child.parent?.name || '').toLowerCase();
            texToApply = loadedTextures.find(t => childName.includes(t.name)) || loadedTextures[0];
          }

          if (texToApply) {
            child.material = new THREE.MeshStandardMaterial({
              map: texToApply.texture,
              roughness: 0.5,
              metalness: 0.05
            });
          } else if (!child.material || (Array.isArray(child.material) && child.material.length === 0)) {
            child.material = new THREE.MeshStandardMaterial({ color: 0x8b9dc3, roughness: 0.5 });
          }
        }
      });
      scene.add(object);
      if (loadingEl) loadingEl.remove();
      fitCameraToObject(object);
    } else {
      // GLB/GLTF with textures: use Three.js GLTFLoader
      const { GLTFLoader } = await import('three/addons/loaders/GLTFLoader.js');
      const loader = new GLTFLoader();
      const gltf = await loader.loadAsync(modelPath);

      if (texturePaths.length > 0) {
        const texLoader = new THREE.TextureLoader();
        const textures = [];
        for (const t of texturePaths) {
          try {
            const tex = await texLoader.loadAsync(t.path);
            tex.colorSpace = THREE.SRGBColorSpace;
            textures.push({ name: t.name.toLowerCase(), texture: tex });
          } catch (e) { console.warn('Texture load failed:', t.path, e); }
        }
        gltf.scene.traverse(child => {
          if (child.isMesh && textures.length > 0) {
            const childName = (child.name || '').toLowerCase();
            const texMatch = textures.find(t => childName.includes(t.name)) || textures[0];
            child.material = new THREE.MeshStandardMaterial({
              map: texMatch.texture,
              roughness: 0.5,
              metalness: 0.05
            });
          }
        });
      }

      scene.add(gltf.scene);
      if (loadingEl) loadingEl.remove();
      fitCameraToObject(gltf.scene);
    }
  } catch (err) {
    console.error('Error cargando modelo:', err);
    if (loadingEl) loadingEl.remove();
    showError('Error al cargar el modelo',
      format === '.ply' ? 'Si es un Gaussian Splat (.ply tipo GS), necesita un visor especializado. Convierte el modelo a GLB para visualizarlo correctamente.' :
      'El archivo puede estar corrupto, dañado o en un formato no compatible.');
  }
}

async function loadPLYAsPoints(url) {
  try {
    const text = await (await fetch(url)).text();
    const lines = text.split('\n');
    let headerEnd = 0;
    let vertexCount = 0;
    const properties = [];

    for (let i = 0; i < lines.length; i++) {
      const line = lines[i].trim();
      if (line.startsWith('element vertex')) {
        vertexCount = parseInt(line.split(/\s+/)[2]);
      } else if (line.startsWith('property')) {
        properties.push(line);
      } else if (line === 'end_header') {
        headerEnd = i + 1;
        break;
      }
    }

    const dataLines = lines.slice(headerEnd, headerEnd + vertexCount);
    const positions = new Float32Array(vertexCount * 3);
    const colors = new Float32Array(vertexCount * 3);
    let hasColor = false;

    let px = properties.findIndex(p => p.includes(' float x') || p.includes(' double x'));
    let py = properties.findIndex(p => p.includes(' float y') || p.includes(' double y'));
    let pz = properties.findIndex(p => p.includes(' float z') || p.includes(' double z'));
    let pr = properties.findIndex(p => p.includes(' red') || p.includes(' r '));
    let pg = properties.findIndex(p => p.includes(' green') || p.includes(' g '));
    let pb = properties.findIndex(p => p.includes(' blue') || p.includes(' b '));

    if (pr === -1) pr = properties.findIndex(p => p.includes('diffuse_red'));
    if (pg === -1) pg = properties.findIndex(p => p.includes('diffuse_green'));
    if (pb === -1) pb = properties.findIndex(p => p.includes('diffuse_blue'));

    hasColor = pr >= 0 && pg >= 0 && pb >= 0;

    const totalProps = properties.length;
    for (let i = 0; i < vertexCount && i < dataLines.length; i++) {
      const vals = dataLines[i].trim().split(/\s+/).map(Number);
      positions[i*3] = vals[px] || 0;
      positions[i*3+1] = vals[py] || 0;
      positions[i*3+2] = vals[pz] || 0;
      if (hasColor) {
        colors[i*3] = (vals[pr] || 0) / 255;
        colors[i*3+1] = (vals[pg] || 0) / 255;
        colors[i*3+2] = (vals[pb] || 0) / 255;
      }
    }

    const geometry = new THREE.BufferGeometry();
    geometry.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
    if (hasColor) geometry.setAttribute('color', new THREE.Float32BufferAttribute(colors, 3));

    const material = new THREE.PointsMaterial({
      size: 0.005,
      vertexColors: hasColor,
      sizeAttenuation: true,
      blending: THREE.NormalBlending,
      depthWrite: true
    });

    const points = new THREE.Points(geometry, material);
    scene.add(points);
    if (loadingEl) loadingEl.remove();
    fitCameraToObject(points);
  } catch (err) {
    console.error('Error loading PLY as points:', err);
    if (loadingEl) loadingEl.remove();
    showError('Error al cargar PLY como nube de puntos', err.message);
  }
}

loadModel();

function animate() {
  requestAnimationFrame(animate);
  controls.update();
  renderer.render(scene, camera);
}
animate();

window.addEventListener('resize', () => {
  camera.aspect = container.clientWidth / container.clientHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(container.clientWidth, container.clientHeight);
});
</script>
<% } else { %>
<script>
  const mv = document.querySelector('#model-viewer');
  const arStatus = document.getElementById('ar-status');
  const arBtn = document.getElementById('btn-ar-activate');

  const isMobile = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);

  if (!isMobile) {
    if (arStatus) arStatus.innerHTML = '<span style="color:#bark-light">Escritorio</span> &mdash; abre esta pagina en tu movil para usar AR.';
    if (arBtn) arBtn.disabled = true;
    if (arBtn) arBtn.style.opacity = '0.5';
  }

  if (mv) {
    mv.addEventListener('load', () => {
      // Fix material opacity for mobile/AR
      const fixMaterials = () => {
        try {
          if (!mv.model) return;
          const mats = mv.model.materials || [];
          if (!Array.isArray(mats) || mats.length === 0) return;
          mats.forEach(mat => {
            try {
              mat.setAlphaMode('OPAQUE');
              if (mat.pbrMetallicRoughness) {
                const [r,g,b] = mat.pbrMetallicRoughness.baseColorFactor || [1,1,1,1];
                mat.pbrMetallicRoughness.setBaseColorFactor([r,g,b,1]);
              }
            } catch(_) {}
          });
        } catch(_) {}
      };
      fixMaterials();
      setTimeout(fixMaterials, 300);

      if (mv.canActivateAR) {
        if (arStatus) arStatus.innerHTML = '<span style="color:var(--sage-dark)">AR disponible</span> &mdash; toca el boton flotante o "Activar AR"';
        if (arBtn) { arBtn.disabled = false; arBtn.style.opacity = '1'; }
      } else if (isMobile) {
        if (arStatus) arStatus.innerHTML = '<span style="color:var(--gold)">AR no soportada</span> &mdash; usa Chrome en Android o Safari en iOS 12+.';
      } else {
        if (arStatus) arStatus.innerHTML = '<span style="color:var(--bark-light)">Listo</span> &mdash; abre en movil para AR.';
      }
    });

    mv.addEventListener('ar-status', (e) => {
      const s = e.detail.status;
      if (s === 'session-started') {
        // Re-fix for AR session
        try {
          if (mv.model) {
            const mats = mv.model.materials || [];
            mats.forEach(mat => {
              try { mat.setAlphaMode('OPAQUE'); } catch(_) {}
            });
          }
        } catch(_) {}
        if (arStatus) arStatus.innerHTML = '<span style="color:var(--sage-dark)">AR activa</span> &mdash; apunta la camara a una superficie plana.';
      } else if (s === 'object-placed') {
        if (arStatus) arStatus.innerHTML = '<span style="color:var(--sage-dark)">Modelo colocado</span> &mdash; muevete alrededor. Si no lo ves, mira hacia el suelo.';
      } else if (s === 'failed') {
        if (arStatus) arStatus.innerHTML = '<span style="color:var(--clay)">Fallo AR</span> &mdash; busca una superficie plana bien iluminada y vuelve a intentar.';
      } else if (s === 'not-started') {
        if (arStatus) arStatus.innerHTML = '<span style="color:var(--sage-dark)">AR disponible</span> &mdash; toca el boton para empezar.';
      }
    });

    mv.addEventListener('error', (e) => {
      console.error('model-viewer error:', e.detail);
      if (arStatus && e.detail && e.detail.type === 'webxr') {
        arStatus.innerHTML = '<span style="color:var(--clay)">Error WebXR</span> &mdash; necesita HTTPS y un dispositivo compatible.';
      } else if (arStatus) {
        arStatus.innerHTML = '<span style="color:var(--clay)">Error de carga</span> &mdash; el modelo GLB puede estar dañado.';
      }
    });

    mv.addEventListener('progress', (e) => {
      const bar = document.getElementById('mv-progress');
      if (bar && e.detail && e.detail.totalProgress !== undefined) {
        bar.style.width = (e.detail.totalProgress * 100) + '%';
      }
    });
  }

  window.triggerAR = function() {
    const m = document.querySelector('#model-viewer');
    if (!m) return;
    if (!m.canActivateAR) {
      if (arStatus) arStatus.innerHTML = '<span style="color:var(--clay)">AR no disponible</span> &mdash; necesitas HTTPS y un movil compatible.';
      return;
    }
    // Fix materials right before AR
    try {
      if (m.model) {
        const mats = m.model.materials || [];
        mats.forEach(mat => {
          try { mat.setAlphaMode('OPAQUE'); } catch(_) {}
        });
      }
    } catch(_) {}
    m.activateAR().catch(err => {
      console.error('activateAR error:', err);
      if (arStatus) arStatus.innerHTML = '<span style="color:var(--clay)">Error AR</span> &mdash; ' + (err.message || 'intentalo de nuevo en una superficie plana.');
    });
  };
</script>
<% } %>
