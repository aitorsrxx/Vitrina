<div class="hero">
  <h1>Catalogo de Especies</h1>
  <p>Explora los escaneos 3D de nuestra coleccion. Escanea el QR en la vitrina o selecciona una especie para verla en realidad aumentada.</p>
</div>

<div class="gallery">
  <% if (species.length === 0) { %>
    <div class="empty-state">
      <div class="empty-icon">&#x1F331;</div>
      <h2>No hay especies aun</h2>
      <p>Ve al <a href="/admin">panel de administracion</a> para anadir la primera especie a la coleccion.</p>
    </div>
  <% } else { %>
    <% species.forEach(item => { %>
      <a href="/especie/<%= item.id %>" class="gallery-card">
        <div class="card-image">
          <% if (item.thumbnail) { %>
            <img src="<%= item.thumbnail %>" alt="<%= item.name %>" loading="lazy">
          <% } else { %>
            <div class="card-placeholder">
              <model-viewer
                src="<%= item.modelPath %>"
                camera-controls
                auto-rotate
                interaction-prompt="none"
                style="width:100%;height:100%"
              ></model-viewer>
            </div>
          <% } %>
        </div>
        <div class="card-info">
          <h3><%= item.name %></h3>
          <% if (item.scientificName) { %>
            <em><%= item.scientificName %></em>
          <% } %>
        </div>
      </a>
    <% }) %>
  <% } %>
</div>
